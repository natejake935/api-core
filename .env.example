# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------- Customer Identity ----------
CUSTOMER_NAME=Blue Volt Electric
AGENCY_NAME=Ironclad Digital
AGENCY_LOCATION=San Diego, CA

# ---------- Server ----------
PORT=3001
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://customerdomain.com,https://www.customerdomain.com

# A secret token the frontend sends as X-Api-Key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_PUBLIC_KEY=

# ---------- Telnyx (SMS + Email) ----------
# API key from portal.telnyx.com → API Keys.
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS — the Telnyx phone number or messaging profile to send from.
TELNYX_FROM_NUMBER=+1xxxxxxxxxx

# Email — the verified sender address in your Telnyx account.
TELNYX_EMAIL_FROM=notifications@customerdomain.com

# Where internal notifications are delivered (your phone + email).
NOTIFY_SMS=+1xxxxxxxxxx
NOTIFY_EMAIL=you@ironcladdigital.agency

# ---------- Go High Level (CRM) ----------
# API key — GHL dashboard → Settings → Business Info → API Key (Private Integration Token).
GHL_API_KEY=

# Location ID — GHL dashboard → Settings → Business Info → Location ID.
GHL_LOCATION_ID=

# Pipeline and stage IDs — GHL dashboard → Opportunities → (open a pipeline) → copy from URL.
GHL_PIPELINE_ID=
GHL_STAGE_ID=

# Optional: GHL custom field IDs for the extra lead data.
# Create fields under Settings → Custom Fields, then paste the IDs here.
# GHL_FIELD_SERVICE_TYPE=
# GHL_FIELD_SERVICE_AREA=
# GHL_FIELD_MONTHLY_LEADS=
# GHL_FIELD_CHALLENGE=
