# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------- Customer Identity ----------
CUSTOMER_NAME=Blue Volt Electric
AGENCY_NAME=Ironclad Digital
AGENCY_LOCATION=San Diego, CA

# ---------- Server ----------
PORT=3001
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://customerdomain.com,https://www.customerdomain.com

# A secret token the frontend sends as X-Api-Key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_PUBLIC_KEY=

# ---------- Twilio (SMS + Email) ----------
# Find these in your Twilio Console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS — the Twilio phone number to send from.
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Email — the verified sender address in your Twilio account.
TWILIO_EMAIL_FROM=notifications@customerdomain.com

# Where internal notifications are delivered (your phone + email).
NOTIFY_SMS=+1xxxxxxxxxx
NOTIFY_EMAIL=you@ironcladdigital.agency

# ---------- HubSpot (CRM) — add when ready ----------
# HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HUBSPOT_PIPELINE_ID=
# HUBSPOT_STAGE_NEW_LEAD=
