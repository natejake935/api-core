# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------- Customer Identity ----------
CUSTOMER_NAME=Blue Volt Electric
AGENCY_NAME=Ironclad Digital
AGENCY_LOCATION=San Diego, CA

# ---------- Server ----------
PORT=3001
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://customerdomain.com,https://www.customerdomain.com

# A secret token the frontend sends as X-Api-Key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_PUBLIC_KEY=

# ---------- Resend (email) ----------
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# The verified "from" email address for this customer's domain.
RESEND_FROM=notifications@customerdomain.com

# Where new booking notifications are delivered (your agency inbox or the customer's).
RESEND_NOTIFY_TO=you@ironcladdigital.agency

# ---------- Twilio (SMS) — add when ready ----------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# NOTIFY_SMS=+1xxxxxxxxxx

# ---------- HubSpot (CRM) — add when ready ----------
# HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HUBSPOT_PIPELINE_ID=
# HUBSPOT_STAGE_NEW_LEAD=
